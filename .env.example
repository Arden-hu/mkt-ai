# Leave empty to use the polished offline demo generator.
# Set these to enable an OpenAI-compatible chat-completions endpoint.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

